{
  "manifest_version": 3,
  "name": "ポジティブフィンガー",
  "version": "0.2.1",
  "description": "使うページだけでオンにする、ポジティブなことばと相棒のChrome版プロトタイプ。入力文は送信・保存しません。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://ctyzaihzltcncspujmnb.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ポジティブフィンガー",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://ctyzaihzltcncspujmnb.supabase.co"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
